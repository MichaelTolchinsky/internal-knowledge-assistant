# Copy to .env for local overrides. Never commit a real .env file.

DATABASE_URL=postgresql+psycopg://knowledge_assistant:knowledge_assistant@localhost:5432/knowledge_assistant

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

CHUNK_SIZE=800
CHUNK_OVERLAP=100

TOP_K=5
SIMILARITY_THRESHOLD=

BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1

LLM_PROVIDER=local
LOCAL_LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

PROMPT_TEMPLATE_VERSION=v1

# Optional LangSmith tracing (docs/ARCHITECTURE.md section 7: "LangSmith traces where they add
# value for LLM/RAG-specific debugging"). Leave empty to keep tracing fully disabled - this is
# the default/expected state; no LangSmith account is required to run the app. Setting a real
# API key here (from https://smith.langchain.com) enables tracing on RAGService.
# answer_question_with_trace via the `@traceable` decorator - out of scope to set up an account
# as part of this task.
LANGSMITH_API_KEY=
